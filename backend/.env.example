# ─────────────────────────────────────────────────────────────────────────────
# DeepGuard AI Backend — Environment Configuration Template (.env.example)
# Copy this file to .env and configure for your local/deployment environment.
# ─────────────────────────────────────────────────────────────────────────────

# Application Environment ("development", "staging", "production")
ENVIRONMENT="development"
PROJECT_NAME="DeepGuard AI API"
DEBUG=false

# Database Configuration
# Local SQLite default:
DATABASE_URL="sqlite:///./deepguard.db"
# PostgreSQL production example:
# DATABASE_URL="postgresql://postgres:postgres_secure_password@localhost:5432/deepguard"

# Connection Pooling (PostgreSQL / MySQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Security & JWT Tokens
# GENERATE A SECURE SECRET IN PRODUCTION: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET="replace-with-a-cryptographically-secure-random-secret-key-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Storage Settings
# UPLOAD_STORAGE_DIR="/app/uploads"
MAX_UPLOAD_SIZE_MB=50

# AI Inference Settings
# Path to trained model weights (.pth file). Leave empty or unset to use default initial architecture.
AI_MODEL_PATH=""
AI_INFERENCE_TIMEOUT=30
AI_DEVICE="auto"
AI_MODEL_NAME="deepguard-cnn-v1"

# ── Email / SMTP Delivery (Registration & Password-Reset OTPs) ────────────────
# For Gmail SMTP:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address and App Password below:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-16-char-app-password"
MAIL_FROM_NAME="DeepGuard AI"

