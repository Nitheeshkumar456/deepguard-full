{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DetectionResponse",
  "type": "object",
  "properties": {
    "is_authentic": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "message": {
      "type": "string"
    },
    "probabilities": {
      "type": "object",
      "properties": {
        "authentic": {
          "type": "number"
        },
        "deepfake": {
          "type": "number"
        }
      },
      "required": ["authentic", "deepfake"]
    }
  },
  "required": ["is_authentic", "confidence", "message"]
}
