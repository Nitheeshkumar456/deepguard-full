# General
APP_ENV=development   # set to 'production' in prod
LOG_LEVEL=info

# Backend (FastAPI)
POSTGRES_USER=deepguard
POSTGRES_PASSWORD=example_password
POSTGRES_DB=deepguard
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://$(POSTGRES_USER):$(POSTGRES_PASSWORD)@$(POSTGRES_HOST):$(POSTGRES_PORT)/$(POSTGRES_DB)

# JWT
JWT_SECRET_KEY=replace_with_secure_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Service
MODEL_DIR=/app/models
AI_WORKERS=2

# File Storage (local default)
UPLOAD_DIR=/app/uploads
# If using S3, set the following instead:
# S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=

# Email / SMTP (Registration & Password-Reset OTPs)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME="DeepGuard AI"

# Web Frontend
VITE_API_BASE_URL=http://localhost:8000/api

# Android (gradle properties)
API_BASE_URL=http://localhost:8000/api
